# Server
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/time_tracker
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/time_tracker
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Web Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000/api/ws

# Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=time_tracker
